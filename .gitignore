# Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Secrets — never commit the API key
.env

# Runtime state. Seed data (data/*.json) IS tracked; the working DB is not,
# since it is rebuilt from seed on startup and every run mutates it.
data/app.db
data/app.db.bak

# Uploaded invoice PDFs (local DocumentStore backend, backend/documents.py).
# Runtime state written per-run, not seed data -- never committed.
data/documents/

# Local scratch
_shots/
_*.py

# OS
.DS_Store
Thumbs.db
desktop.ini
