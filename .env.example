# Copy this file to .env and fill in real values. .env is gitignored; this
# file is not, and must never contain a real secret or key.

# --- Database -----------------------------------------------------------
# Required. PostgreSQL is the live application database in both development
# and production -- there is no SQLite fallback (see backend/storage.py).
# Nothing in the code cares WHERE the Postgres instance lives; this is a
# plain libpq connection string.
#
# SUPABASE (recommended). Project Settings -> Database -> Connection string
# in the Supabase dashboard gives you three variants -- pick the SESSION
# variant, not Transaction:
#
#   Direct connection      db.<project-ref>.supabase.co:5432       IPv6 only
#                           unless your project has the paid IPv4 add-on.
#   Session pooler         aws-0-<region>.pooler.supabase.com:5432 IPv4,
#                           behaves like a direct connection.
#   Transaction pooler      ...pooler.supabase.com:6543             IPv4, but
#                           DO NOT USE IT HERE.
#
# WHY NOT THE TRANSACTION POOLER: this app runs its own connection pool
# (backend/storage.py's ThreadedConnectionPool) and issues `SET search_path`
# once per borrowed connection, then runs several statements against it
# before returning it (see get_conn()/write_txn()). PgBouncer's transaction
# mode recycles the underlying server connection between statements, so a
# session-scoped SET is not guaranteed to still apply to the next statement
# on "the same" connection -- and it does not support prepared statements
# either. The session pooler and the direct connection both give a real,
# stable session per connection, which is what this app assumes throughout.
#
# Supabase's own connection strings already include `sslmode=require`; keep
# it if you build the URL by hand -- Supabase refuses plaintext connections.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# LOCAL DEV WITHOUT SUPABASE. `docker-compose up -d` starts a throwaway local
# Postgres matching the default below, for fully offline work or CI:
DATABASE_URL=postgresql://invoice_app:devpassword_app@127.0.0.1:5432/invoice_processing

# How many connections this process may hold open at once. Default 16.
#
# It used to be hard-coded at 10, which is fewer than the 40 threads the server
# runs synchronous endpoints on -- so a burst of ordinary reads (somebody
# pressing Refresh a few times) could ask for more connections than existed,
# and the surplus requests failed with a 500 instead of waiting their turn.
# get_conn() now waits for a connection, which is the actual fix; this is the
# ceiling, and it is settable because the right number is a property of your
# DATABASE rather than of this code.
#
# A hosted Postgres shares one connection limit across every client -- a
# Supabase direct connection allows far fewer than its pooler does -- so if you
# run several instances, divide that limit between them. Raising this does not
# make anything faster; it only decides how many requests can be served at once
# before the rest queue.
# DB_POOL_MAX=16

# --- Extraction providers (optional) -------------------------------------
# Absent, the app runs on its regex fallback -- weaker extraction, but fully
# functional and needing no key.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Environment ------------------------------------------------------------
# "development" (default) allows the demo conveniences below: the published
# demo accounts in data/users.json and an ephemeral token-signing key.
# Setting this to production/prod/live makes BOTH of those fatal at startup --
# the app refuses to boot rather than running quietly insecure.
APP_ENV=development

# --- API security -----------------------------------------------------------
# Secret used to sign access tokens. If unset, an ephemeral one is generated per
# process and tokens stop working on restart -- there is deliberately no default
# in the code, because a secret committed to a repository is not a secret.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# REQUIRED when APP_ENV is production/prod/live.
AUTH_SECRET=
# Optional: minutes an access token stays valid (default 480).
# AUTH_TOKEN_TTL_MINUTES=480
# Optional: comma-separated browser origins allowed to call this API.
# Empty means same-origin only. CORS is NOT a security control.
#
# REQUIRED FOR A SPLIT DEPLOYMENT (UI on a static host, API elsewhere). Name
# the production frontend origin exactly -- scheme, host, and port if it is not
# the default. No trailing slash, no path; a browser sends an Origin header of
# exactly that shape and a mismatch is silent.
#   CORS_ORIGINS=https://your-app.vercel.app
# CORS_ORIGINS=
#
# Optional: a PATTERN of additional allowed origins, for preview deployments
# whose hostnames do not exist yet when this is configured. Checked in ADDITION
# to CORS_ORIGINS, never instead of it. It MUST be anchored with ^ and $, and a
# production start refuses a pattern loose enough to match an arbitrary origin
# -- a regex is a much quieter way to reach allow_origins=["*"] than typing the
# asterisk. Leave it unset unless you actually need preview builds to work.
#   CORS_ORIGIN_REGEX=^https://your-app-[a-z0-9-]+-yourteam\.vercel\.app$
# CORS_ORIGIN_REGEX=

# --- Split deployment (UI and API on different origins) ---------------------
# Everything in this application uses relative URLs, which is correct whenever
# one process serves both the UI and the API -- the local demo, and any
# single-container deployment. Two settings exist for when it does not.
#
# 1. THE BACKEND needs to know where to send a browser after Google's OAuth
#    consent screen. Google redirects the ADMINISTRATOR'S BROWSER to this API
#    host, and a relative "/" would land them on the API rather than back on
#    the screen they left -- including for the failure results, which are the
#    ones that most need to be read. Origin only: scheme://host[:port], no
#    path. A malformed value is ignored and the redirect stays relative.
#   FRONTEND_ORIGIN=https://your-app.vercel.app
# FRONTEND_ORIGIN=
#
# 2. THE FRONTEND needs to know where the API is. That one is NOT set here --
#    it is a build-time variable for the UI's own build, set wherever the UI is
#    built (Vercel project settings, or frontend-next/.env.local locally):
#
#      NEXT_PUBLIC_API_BASE_URL=https://your-api.up.railway.app
#
#    NEXT_PUBLIC_* is compiled into the browser bundle by design. It must be a
#    public origin and nothing else -- never a key, never a token. Changing it
#    means REBUILDING the UI, not restarting anything.
#
# 3. Behind a platform proxy (Railway, Fly, a load balancer), turn this on so
#    per-IP rate limiting sees the real client rather than the proxy -- which
#    would otherwise count every user in the world as one address.
#   TRUST_PROXY_HEADERS=1
# TRUST_PROXY_HEADERS=
# Optional: invoice-processing requests per minute per user (default 20).
# RATE_LIMIT_PROCESS_PER_MINUTE=20
# Optional: sign-in attempts per minute, per source IP and per target ACCOUNT.
# The second one is what protects a single account from guessing spread across
# many addresses, which the per-IP figure alone cannot see. Neither is a
# lockout: both windows expire on their own, so there is no state an attacker
# can leave behind to keep somebody else signed out.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_LOGIN_PER_USER_PER_MINUTE=15
# Optional: analytics, log-search and CSV-export calls per minute per user.
# These reads are far more expensive than the ones beside them -- an export
# streams up to 50,000 rows, and the rule and stage filters parse every run's
# JSON in the window. Set generously: this is a ceiling on automation, not on
# use, and a dashboard opening several panels at once must never hit it.
# RATE_LIMIT_REPORTING_PER_MINUTE=120

# --- HTTP security headers --------------------------------------------------
# On by default. Turn OFF only when a proxy in front of this app sets its own
# and you would rather not have both.
# SECURITY_HEADERS_ENABLED=1
# HSTS max-age in seconds. Sent ONLY when APP_ENV is production, because it is
# the one header here that is hard to take back: a browser told to pin https
# for a year will refuse plain http to that host for a year. 0 disables it.
# HSTS_MAX_AGE_SECONDS=31536000
# Override the Content-Security-Policy entirely. The default allows this app's
# own static bundle plus the blob: URLs the PDF preview renders. It contains
# 'unsafe-inline' for scripts because the UI is a Next.js STATIC export with an
# inline theme bootstrap and no server pass in which to stamp a nonce -- so
# treat the policy as attack-surface reduction, not as XSS immunity.
# CONTENT_SECURITY_POLICY=

# --- Account deactivation ---------------------------------------------------
# There is no setting for this: it lives on the user record. Add "disabled":
# true (or "active": false) to an entry in the user store to cut off both new
# sign-ins AND any token that account already holds, from the next request.
#
# TO REVOKE ACCESS, DISABLE THE RECORD -- DO NOT MERELY DELETE IT. A deleted
# record leaves the outstanding token valid until it expires, because a
# principal with no local record is how an external identity provider's tokens
# legitimately look. See CLAUDE.md, Phase K.

# --- The user store ---------------------------------------------------------
# Where the accounts live. Defaults to data/users.json, which ships six DEMO
# accounts whose passwords are published in this repository and on the sign-in
# screen -- so APP_ENV=production refuses to start while any of them is
# present. That refusal is the point; do not work around it by removing the
# "demo" flag.
# AUTH_USERS_FILE=data/users.json
#
# A CONTAINER HAS NOWHERE DURABLE TO KEEP A FILE, so a production deployment
# passes the store as an environment variable instead and the container writes
# it to AUTH_USERS_FILE at startup (scripts/start-backend.sh). Build the value
# locally -- it prompts for each password and never stores one:
#
#   python scripts/make_user_store.py generate --user alice:admin --user bob:reviewer
#
# then paste the single line it prints into AUTH_USERS_JSON. It contains PBKDF2
# password HASHES, not passwords, but it is still a credential file: set it as
# a secret, never commit it, and never expose it to the browser.
# AUTH_USERS_JSON=

# --- Daily extraction budget (circuit breaker) ------------------------------
# A second, slower guard than the per-minute rate limit. Steady, ordinary use
# can drain a provider for the whole day without ever tripping a per-minute
# limit -- and Gemini's free tier is 20 requests per DAY on the only route that
# can read a scanned invoice. When a budget is spent the provider is NOT called:
# text falls back to regex, scans go to review. Same safe paths as an outage.
# DAILY_QUOTA_VISION=20
# DAILY_QUOTA_TEXT=500
# DAILY_QUOTA_ENABLED=1

# --- The assistant (Phase K2) -----------------------------------------------
# The read-only chatbot uses the GROQ text route (GROQ_API_KEY above). With no
# key it still works: answers come straight from the records, laid out rather
# than written up. There is no separate key or provider to configure.
#
# Its budgets are deliberately its OWN, not shared with extraction: if chat
# could drain the invoice-reading budget, a chatty afternoon would leave the
# pipeline unable to read a scan.
# DAILY_QUOTA_CHAT=300
# RATE_LIMIT_CHAT_PER_MINUTE=30

# --- The supplier portal (Phase J) -------------------------------------------
# External clients reach only /api/portal/*, and these are the only limits that
# apply to them. They are separate from the internal ones deliberately: this is
# the one surface reachable from outside the company, and a shared counter
# would let one vendor's runaway script exhaust a budget an employee also
# draws on.
#
# Reading is cheap, so the read ceiling is generous -- it bounds automation,
# not use. Submission is not: it drives the full extraction pipeline, so it
# gets a low per-minute ceiling and a PER-CLIENT daily budget behind it. That
# budget is per client rather than one shared key so the first vendor through
# the door cannot spend everyone else's allowance -- and it exists at all so
# that an outside party cannot exhaust the vision quota the internal pipeline
# depends on and which has no fallback.
#
# There is nothing to switch on: the portal is live whenever the user store
# contains an account with a `client` role. It has no endpoints an internal
# account can reach and no internal endpoint a client account can reach.
# RATE_LIMIT_PORTAL_PER_MINUTE=60
# RATE_LIMIT_PORTAL_SUBMIT_PER_MINUTE=5
# DAILY_QUOTA_PORTAL_SUBMISSIONS=25

# --- Document storage (uploaded invoice PDFs) --------------------------------
# "local" (default) writes files under data/documents/ -- needs nothing else
# configured. "postgres" writes them into the database this application already
# has -- needs nothing else configured either, and unlike "local" it survives a
# container being replaced. "s3" writes to an S3-compatible bucket, for a real
# deployment at volume; requires `boto3` (not installed by default) and
# DOCUMENT_S3_BUCKET below.
# DOCUMENT_STORE_BACKEND=local
# DOCUMENT_STORAGE_DIR=./data/documents
# DOCUMENT_S3_BUCKET=
# DOCUMENT_S3_PREFIX=
# DOCUMENT_S3_REGION=
# DOCUMENT_S3_ENDPOINT_URL=
#
# A CONTAINER FILESYSTEM DOES NOT SURVIVE A RESTART. On Railway, Fly, Render or
# any similar host, "local" means every uploaded PDF is gone at the next deploy
# -- the `documents` ROW survives (it is in Postgres) so the run still opens,
# but the download 404s and the audit report has no source document. Nothing
# warns you, because from the application's point of view the file was written.
#
# So "local" is the one value never to leave set on such a host. Two ways out:
#
#   DOCUMENT_STORE_BACKEND=postgres
#
# is the whole configuration. The PDF bytes go into a `document_blobs` table in
# the database you have already pointed DATABASE_URL at -- no bucket, no key
# pair, no second vendor, and the table is created on first use, so there is no
# migration step. At AP volumes (one row per invoice, a few hundred KB, read
# when a reviewer opens one) this is the right trade; at a much larger one the
# bytes belong in object storage and you switch to "s3" with no code change.
#
# Any S3-compatible bucket works; boto3 is already installed in the container
# image. Supabase Storage speaks S3, which keeps the whole deployment on one
# vendor -- Project Settings -> Storage -> S3 connection gives you the endpoint
# and region, and Storage -> S3 Access Keys gives you the credentials:
#
#   DOCUMENT_STORE_BACKEND=s3
#   DOCUMENT_S3_BUCKET=invoice-documents
#   DOCUMENT_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   DOCUMENT_S3_REGION=<your project region, e.g. ap-south-1>
#   AWS_ACCESS_KEY_ID=<S3 access key id>
#   AWS_SECRET_ACCESS_KEY=<S3 secret access key>
#
# AWS_* are read by boto3 itself, not by this application -- which is why they
# are not listed among this file's own settings. On real AWS, an instance role
# is better than either of them.

# --- Review claims (multi-user review) ---------------------------------------
# How long one employee's claim on a NEEDS_REVIEW invoice holds before another
# may take it over. A lease, not a lock: a closed tab must not block an invoice
# forever, and there is no background sweep -- the next claim attempt after this
# window simply finds the old claim expired.
# REVIEW_CLAIM_LEASE_MINUTES=15

# --- Email security & trusted-source verification (Phase F) ------------------
# WHICH AUTHENTICATION-RESULTS HEADERS ARE BELIEVED.
# `Authentication-Results` is an ordinary header: anyone can put one in a
# message they send, saying "dmarc=pass". It is only worth reading when it was
# stamped by a receiving boundary YOU control. This is the allowlist of those
# boundaries' authserv-ids (comma-separated, e.g. your gateway's hostname).
#
# EMPTY IS THE DEFAULT AND IS SAFE, NOT BROKEN: with nothing listed, no relayed
# verdict is believed, so every message that carries no verifiable DKIM
# signature is classified UNVERIFIED and quarantined for a human rather than
# trusted. Set this only to hostnames you actually operate.
# EMAIL_TRUSTED_AUTHSERV_IDS=mx.your-company.example

# Where DKIM public keys and DMARC policies are looked up.
# "none" (default) does no DNS at all: DKIM signatures are reported
# `unavailable` -- never `fail`, because a key that could not be fetched has not
# failed anything. "dnspython" performs live lookups and needs the `dnspython`
# package (not installed by default).
# EMAIL_DNS_RESOLVER=none

# User-level (S/MIME or PGP) signature verification. Only "none" is
# implemented: it DETECTS a signature and records its status as unavailable,
# and has no code path that reports a pass. Verifying one for real needs a
# configured trust anchor and revocation source, which this deployment has not
# got -- see backend/email_signature.py. Any other value raises rather than
# silently downgrading to detection.
# EMAIL_SIGNATURE_VERIFIER=none

# Cap on a submitted message. Defaults to twice MAX_UPLOAD_BYTES, because a
# message carrying a PDF is necessarily larger than the PDF alone (base64 costs
# about a third, plus headers and other parts).
# EMAIL_MAX_MESSAGE_BYTES=31457280

# --- Email invoice ingestion (Phase G) ---------------------------------------
# Phase F verifies a message HANDED to the application. Phase G goes and gets
# one. Ingestion is OFF unless both of the next two are set, so an install that
# does not want it opens no outbound connection at all.
# EMAIL_INGEST_ENABLED=1
# EMAIL_PROVIDER=imap            # imap | gmail | none (default)
#
# NOTE (Phase G2): a Gmail mailbox connected through Settings -> Email
# integration needs NEITHER of the two above. A connection an administrator
# created through the consent screen is itself the instruction to poll it, so
# an UNSET EMAIL_PROVIDER defers to one. Setting EMAIL_PROVIDER explicitly
# always wins, so `imap` is never overridden by a stored Gmail connection.

# How often the background poller runs, and how many messages it takes per pass.
# Safe to run in several uvicorn workers at once: duplicate suppression is a
# UNIQUE constraint on (provider, provider_message_id) in PostgreSQL, not
# coordination between pollers.
# EMAIL_POLL_SECONDS=120
# EMAIL_POLL_BATCH=25

# IMAP connection. ALWAYS TLS -- there is no plaintext option.
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=ap-invoices@your-company.example
# EMAIL_IMAP_FOLDER=INBOX
# EMAIL_IMAP_SEARCH=UNSEEN
# EMAIL_IMAP_MARK_SEEN=1

# CREDENTIALS. Put real values in .env (which is gitignored) or in your
# platform's secret store -- never in this file, never in source, never in a
# commit. An OAuth access token is PREFERRED over a mailbox password and is
# used in place of one whenever it is set: it is short-lived and scoped, and a
# mailbox password is neither. Gmail and Microsoft 365 both accept it over IMAP
# as SASL XOAUTH2.
# EMAIL_IMAP_OAUTH_TOKEN=
# EMAIL_IMAP_PASSWORD=

# Sender classification for the cheap pre-filter. The bulk of the policy lives
# in data/email_domain_policy.json (corporate domains, free-mail domains);
# these add to it without editing the file. Comma-separated.
#
# NOTE these decide sender TYPE, not trust. Which vendors you actually accept
# invoices from is data/trusted_email_senders.json (Phase F) -- a corporate
# sender is not automatically trusted, and a personal one is not automatically
# refused.
# EMAIL_CORPORATE_DOMAINS=your-company.example,subsidiary.example
# EMAIL_PERSONAL_DOMAINS=some-regional-isp.example

# --- Gmail OAuth (Phase G2) --------------------------------------------------
# Lets an administrator connect a Gmail mailbox from inside the application
# instead of putting a mailbox password in this file. Nothing here is a Gmail
# credential: these identify THIS APPLICATION to Google. The mailbox owner
# authenticates at Google, and this application never sees their password.
#
# SETTING UP THE GOOGLE OAUTH CLIENT (once per deployment)
#
#   1. https://console.cloud.google.com/ -> create or pick a project.
#   2. APIs & Services -> Library -> enable the **Gmail API**.
#   3. APIs & Services -> OAuth consent screen:
#        - User type: Internal if this is a Google Workspace domain (no
#          verification needed); External otherwise, which requires Google's
#          review before anyone outside your test users can connect.
#        - Add the scope .../auth/gmail.readonly and nothing else.
#   4. APIs & Services -> Credentials -> Create credentials ->
#      OAuth client ID -> **Web application**.
#   5. Authorised redirect URI: EXACTLY the value of
#      GOOGLE_OAUTH_REDIRECT_URI below. Google matches it character for
#      character -- a trailing slash, http vs https, or a different port is a
#      redirect_uri_mismatch at the consent screen.
#   6. Copy the client ID and client secret into .env (NOT into this file).
#
# THE REDIRECT URI IS ALWAYS <your public origin> + /api/email/oauth/gmail/callback
# Google requires https for anything that is not localhost, so a real
# deployment must be behind TLS before this can work at all.
#
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://ap.your-company.example/api/email/oauth/gmail/callback

# The Gmail permission(s) requested at the consent screen, space-separated.
# Defaults to gmail.readonly, which reads messages and downloads attachments
# and can do nothing else -- it cannot send, reply, delete, or change a label.
#
# gmail.modify is worth adding ONLY if you want ingested mail marked as read
# in the mailbox. Nothing requires it.
#
# gmail.send -- send-only, and unable to read a single message -- is worth
# adding ONLY if you want reviewers to be able to email a vendor why their
# invoice was rejected (see README's "Rejection notifications & audit
# export"). It must be combined with a read scope (readonly or modify); an
# EXISTING connection does not gain it automatically -- Google fixes a
# token's scopes at consent time, so add it here and click Reconnect in
# Settings.
#
# https://mail.google.com/ (the IMAP scope, which grants full mailbox
# control including delete) is REFUSED by this application rather than
# merely discouraged, and stays refused even with gmail.send configured.
# GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Rejection-notification emails per reviewer per minute. Each one sends a
# real message to a real vendor, so this is deliberately low.
# RATE_LIMIT_NOTIFY_PER_MINUTE=10

# An optional Gmail search expression narrowing what is polled. The default
# excludes chats and nothing else -- deliberately NOT `has:attachment`, because
# a message with no PDF is still recorded (as filtered out, with its reasons)
# rather than never seen.
# GMAIL_SEARCH_QUERY=-in:chats

# How far back the FIRST poll after connecting reaches, in days. Zero by
# default: connecting a mailbox starts reading invoices that arrive from now
# on, rather than ingesting and ruling on years of history already dealt with.
# GMAIL_BACKFILL_DAYS=0

# How far behind its high-water mark each poll re-reads, in seconds. Covers a
# message Google delivers slightly out of order. Costs only message ids: an
# already-ingested message is refused before its body is downloaded.
# GMAIL_CURSOR_OVERLAP_SECONDS=300

# WHERE THE STORED TOKENS ARE KEPT, AND HOW
#
# The refresh token Google issues is encrypted (Fernet, from `cryptography`,
# which this project already depends on for DKIM) and held in the
# email_oauth_connections table. No endpoint returns it and no log line
# contains it.
#
# The encryption key is DERIVED FROM AUTH_SECRET by HKDF-SHA256. There is no
# separate key to set -- a second mandatory secret in the same environment
# would add a way to misconfigure a deployment without adding security.
#
# THE CONSEQUENCE, STATED PLAINLY: rotating AUTH_SECRET makes a stored Gmail
# credential undecryptable, exactly as it invalidates every session. It fails
# closed (the connection reports that it needs reconnecting; nothing falls back
# to plaintext) and the remedy is one click of Connect Gmail.
